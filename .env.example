# Copy this file to .env for local development. Do not commit .env.

# Database (Supabase PostgreSQL)
DATABASE_URL=

# Aegis email verification (server-only)
AEGIS_VERIFICATION_BASE_URL=https://aegis-api.i-jer.com
# Leave empty unless the Aegis deployment requires x-api-key.
AEGIS_VERIFICATION_API_KEY=

# Signed participant session (generate at least 32 random bytes)
SESSION_SECRET=
SESSION_TTL_DAYS=7

# Authenticated workshop invitation redirects (server-only, one URL per path)
WORKSHOP_CTF_COMMUNITY_LINK=
WORKSHOP_BCC_COMMUNITY_LINK=
WORKSHOP_CP_COMMUNITY_LINK=

# Cloudflare R2 PDF storage
# Local Next.js connects to a private development bucket through the S3 API.
# Create this bucket once in Cloudflare; do not enable public r2.dev access.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Shared development bucket name; production must use a different bucket.
R2_BUCKET_NAME=sparta-submissions-dev
# Standard endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# PDF upload limit: 5 MiB
MAX_SUBMISSION_FILE_SIZE_BYTES=5242880
